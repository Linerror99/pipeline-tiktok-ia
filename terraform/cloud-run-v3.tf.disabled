# ========================================
# Cloud Run V3 — Backend & Frontend Reetik
# ========================================

# Artifact Registry pour les images Docker V3
resource "google_artifact_registry_repository" "docker_repo_v3" {
  location      = var.region
  repository_id = "reetik-v3"
  description   = "Docker images pour Reetik V3"
  format        = "DOCKER"

  depends_on = [google_project_service.required_apis]
}

# ── Backend V3 ──────────────────────────────────────────────────────────────

resource "google_cloud_run_v2_service" "backend_v3" {
  name     = "backend-v3"
  location = var.region
  ingress  = "INGRESS_TRAFFIC_ALL"

  template {
    service_account = google_service_account.cloud_functions_sa.email

    scaling {
      min_instance_count = 0
      max_instance_count = 5
    }

    # Timeout élevé pour les opérations Veo (génération longue)
    timeout = "3600s"

    containers {
      image = "${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.docker_repo_v3.repository_id}/backend-v3:latest"

      ports {
        container_port = 8080
      }

      resources {
        limits = {
          cpu    = "4"
          memory = "4Gi"
        }
        cpu_idle          = true
        startup_cpu_boost = true
      }

      env {
        name  = "PROJECT_ID"
        value = var.project_id
      }

      env {
        name  = "REGION"
        value = var.region
      }

      env {
        name  = "FIRESTORE_DATABASE"
        value = "reetik-v3"
      }

      env {
        name  = "BUCKET_NAME_V3"
        value = var.bucket_name_v3
      }

      env {
        name  = "BUCKET_UPLOADS_V3"
        value = var.bucket_uploads_v3
      }

      env {
        name  = "BUCKET_THUMBNAILS_V3"
        value = var.bucket_thumbnails_v3
      }

      env {
        name  = "JWT_SECRET_KEY"
        value = var.backend_secret_key
      }

      env {
        name  = "GOOGLE_CLOUD_PROJECT"
        value = var.project_id
      }

      env {
        name  = "GOOGLE_CLOUD_LOCATION"
        value = "global"
      }

      env {
        name  = "GOOGLE_GENAI_USE_VERTEXAI"
        value = "True"
      }
    }
  }

  traffic {
    type    = "TRAFFIC_TARGET_ALLOCATION_TYPE_LATEST"
    percent = 100
  }

  depends_on = [
    google_artifact_registry_repository.docker_repo_v3,
    google_project_service.required_apis,
  ]
}

resource "google_cloud_run_v2_service_iam_member" "backend_v3_public" {
  location = google_cloud_run_v2_service.backend_v3.location
  name     = google_cloud_run_v2_service.backend_v3.name
  role     = "roles/run.invoker"
  member   = "allUsers"
}

# ── Frontend V3 ─────────────────────────────────────────────────────────────

resource "google_cloud_run_v2_service" "frontend_v3" {
  name     = "reetik-frontend-v3"
  location = var.region
  ingress  = "INGRESS_TRAFFIC_ALL"

  template {
    scaling {
      min_instance_count = 0
      max_instance_count = 3
    }

    containers {
      image = "${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.docker_repo_v3.repository_id}/frontend-v3:latest"

      ports {
        container_port = 80
      }

      resources {
        limits = {
          cpu    = "1"
          memory = "512Mi"
        }
        cpu_idle          = true
        startup_cpu_boost = false
      }
    }
  }

  traffic {
    type    = "TRAFFIC_TARGET_ALLOCATION_TYPE_LATEST"
    percent = 100
  }

  depends_on = [
    google_artifact_registry_repository.docker_repo_v3,
    google_project_service.required_apis,
  ]
}

resource "google_cloud_run_v2_service_iam_member" "frontend_v3_public" {
  location = google_cloud_run_v2_service.frontend_v3.location
  name     = google_cloud_run_v2_service.frontend_v3.name
  role     = "roles/run.invoker"
  member   = "allUsers"
}

# ── Outputs ─────────────────────────────────────────────────────────────────

output "backend_v3_url" {
  value       = google_cloud_run_v2_service.backend_v3.uri
  description = "URL du backend V3 Cloud Run"
}

output "frontend_v3_url" {
  value       = google_cloud_run_v2_service.frontend_v3.uri
  description = "URL du frontend V3 Cloud Run"
}
